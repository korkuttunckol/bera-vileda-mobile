<?xml version="1.0" encoding="utf-8"?>
<!--
  Drop into / merge with C:\inetpub\LogoApi\web.config

  Purpose (LAN browser CORS only):
  - Allow BERA (Vite localhost / LAN origin) to GET cariler.ashx and stoklar.ashx
  - Does NOT change SQL, ashx query logic, or response JSON shape

  After deploy, recycle the LogoApi app pool or touch web.config.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Credential-less GETs from BERA; LAN-only API — wildcard is OK for now. -->
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Accept, Content-Type" />
        <add name="Access-Control-Max-Age" value="86400" />
      </customHeaders>
    </httpProtocol>

    <!--
      Optional: short-circuit OPTIONS preflight (requires IIS URL Rewrite module).
      BERA's current fetch is a simple GET with Accept: application/json and often
      does NOT send preflight — but OPTIONS support keeps Safari/Chrome happy if
      preflight appears. If URL Rewrite is not installed, omit this <rewrite> block;
      customHeaders above are still enough for the common GET+CORS case.
    -->
    <rewrite>
      <rules>
        <rule name="LogoApiCorsPreflight" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
          </conditions>
          <action type="CustomResponse" statusCode="204" statusReason="No Content" statusDescription="No Content" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
