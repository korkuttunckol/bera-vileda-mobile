# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application
VITE_APP_ENV=development

# Logo Wings stock / ITEMS API (optional; LAN only — no NAT/port-forward).
# LAN test: http://192.168.1.11/LogoApi/stoklar.ashx
# Empty disables Logo product sync UI action.
# Response MUST include LOGICALREF (LG_002_ITEMS.LOGICALREF → Product.erpId).
VITE_LOGO_API_URL=http://192.168.1.11/LogoApi/stoklar.ashx

# Logo Wings customers / CLCARD API (optional; LAN only — no NAT/port-forward).
# LAN test: http://192.168.1.11/LogoApi/cariler.ashx
# Empty disables Logo customer sync UI action.
VITE_LOGO_CUSTOMERS_API_URL=http://192.168.1.11/LogoApi/cariler.ashx
