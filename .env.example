# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application
VITE_APP_ENV=development

# Logo Wings stock / ITEMS API (optional; tried first — company LAN).
# LAN test: http://192.168.1.11/LogoApi/stoklar.ashx
# Empty + empty external disables Logo product sync UI action.
# Response MUST include LOGICALREF (LG_002_ITEMS.LOGICALREF → Product.erpId).
VITE_LOGO_API_URL=http://192.168.1.11/LogoApi/stoklar.ashx

# Logo Wings stock API external / WAN fallback (optional; tried after LAN failure).
# Example: http://88.248.20.232:6581/LogoApi/stoklar.ashx
VITE_LOGO_API_EXTERNAL_URL=

# Logo Wings customers / CLCARD API (optional; tried first — company LAN).
# LAN test: http://192.168.1.11/LogoApi/cariler.ashx
# Empty + empty external disables Logo customer sync UI action.
VITE_LOGO_CUSTOMERS_API_URL=http://192.168.1.11/LogoApi/cariler.ashx

# Logo Wings customers API external / WAN fallback (optional; tried after LAN failure).
# Example: http://88.248.20.232:6581/LogoApi/cariler.ashx
VITE_LOGO_CUSTOMERS_API_EXTERNAL_URL=
