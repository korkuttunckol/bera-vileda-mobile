rules_version = '2';

/**
 * BERA Sipariş Sistemi v2 — Firestore Security Rules
 *
 * Kimlik doğrulama uygulamada yerel (IndexedDB + Firestore users koleksiyonu)
 * yapılır; Firebase Auth kullanılmaz. Bu nedenle request.auth her zaman null'dır.
 *
 * Güvenlik modeli:
 * - Okuma/yazma mobil PWA istemcisine açıktır (sync + offline-first).
 * - Yazmalarda temel alan doğrulaması uygulanır.
 * - Üretimde Firebase App Check + API kısıtlamaları zorunludur.
 * - İleride Custom Token / Cloud Functions ile request.auth eklenebilir.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function hasTimestamps(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt']);
    }

    function isValidUser(data) {
      return isNonEmptyString(data.userCode)
        && isNonEmptyString(data.name)
        && isNonEmptyString(data.passwordHash)
        && data.role in ['admin', 'salesRep', 'merch']
        && data.active is bool
        && (!('isDeleted' in data) || data.isDeleted is bool)
        && hasTimestamps(data);
    }

    function isValidCustomer(data) {
      return isNonEmptyString(data.code)
        && isNonEmptyString(data.name)
        && hasTimestamps(data);
    }

    function isValidBranch(data) {
      return isNonEmptyString(data.customerId)
        && isNonEmptyString(data.name)
        && hasTimestamps(data);
    }

    function isValidProduct(data) {
      return isNonEmptyString(data.sku)
        && isNonEmptyString(data.name)
        && hasTimestamps(data);
    }

    function isValidOrder(data) {
      return isNonEmptyString(data.customerId)
        && isNonEmptyString(data.salesRepId)
        && isNonEmptyString(data.localId)
        && data.keys().hasAny(['orderSyncStatus', 'status'])
        && hasTimestamps(data);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if true;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidCustomer(request.resource.data);
      allow delete: if true;

      match /branches/{branchId} {
        allow read: if true;
        allow create, update: if isValidBranch(request.resource.data);
        allow delete: if true;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidOrder(request.resource.data);
      allow delete: if true;

      match /lines/{lineId} {
        allow read: if true;
        allow create, update: if isNonEmptyString(request.resource.data.orderId)
          && isNonEmptyString(request.resource.data.productSku)
          && request.resource.data.quantity is number;
        allow delete: if true;
      }
    }

    match /syncLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /importLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
